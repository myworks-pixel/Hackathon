# 可公开到浏览器的地址。只有公开配置使用 NEXT_PUBLIC_ 前缀。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 只使用 Tavily、Daytona、CodeAF 和 Nosana。所有密钥先留空。
TAVILY_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=

# Daytona: optional region, plus a snapshot with Python, Git and CodeAF installed.
DAYTONA_TARGET=
DAYTONA_CODEAF_SNAPSHOT=
# strict: custom per-sandbox isolation (requires supported Daytona tier).
# platform: explicitly opt into Daytona's default tier-based firewall.
# Never switches automatically when the custom policy fails.
DAYTONA_NETWORK_POLICY=strict

# CodeAF 在 Daytona 中运行，模型和密钥复用 Nosana，不需要其他模型平台。
# 可选：填 Nosana 上支持工具调用的编码模型 ID，空白则复用 NOSANA_MODEL。
CODEAF_MODEL=

# Nosana：农场文字理解和 LangChain / LangGraph 共用此配置。
# 只接受 Nosana 官方推理地址或 *.node.k8s.prd.nos.ci 上的部署地址。
NOSANA_API_KEY=
NOSANA_BASE_URL=https://inference.nosana.com/v1
NOSANA_MODEL=

# Your Nosana GPU deployments: vision and ASR endpoints ending in /v1.
# These are separate services; the shared text API does not serve ASR.
NOSANA_VISION_BASE_URL=
NOSANA_VISION_API_KEY=
NOSANA_VISION_MODEL=
NOSANA_ASR_BASE_URL=
NOSANA_ASR_API_KEY=
NOSANA_ASR_MODEL=

# Optional absolute data directory. Empty uses .data in this project.
FARM_DATA_DIR=
