# 可公开到浏览器的地址。只有公开配置使用 NEXT_PUBLIC_ 前缀。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LangChain / LangGraph：空白项目允许留空，创建模型时需要 AI_MODEL 和 OPENAI_API_KEY。
# AI_MODEL 填当前账号或兼容服务可用的模型 ID。
AI_MODEL=
# 使用 OpenAI 官方地址时留空；兼容服务填写其 API base URL（通常包含 /v1）。
AI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Agent Forge 合作伙伴：按需填写，暂不使用的服务留空。
TAVILY_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=
