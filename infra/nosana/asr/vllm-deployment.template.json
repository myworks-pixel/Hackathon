{
  "version": "0.1",
  "type": "container",
  "ops": [
    {
      "id": "mikan-asr",
      "type": "container/run",
      "args": {
        "image": "docker.io/vllm/vllm-openai:v0.15.0",
        "gpu": true,
        "expose": 8000,
        "shm_size": "1g",
        "resources": [
          {
            "type": "HF",
            "repo": "openai/whisper-large-v3-turbo",
            "target": "/models/whisper"
          }
        ],
        "cmd": [
          ": \"${VLLM_API_KEY:?Set a private inference key before deployment}\"; exec python3 -m vllm.entrypoints.openai.api_server --model /models/whisper --served-model-name mikan-whisper --host 0.0.0.0 --port 8000 --max-model-len 448 --max-num-seqs 1 --enforce-eager --gpu-memory-utilization 0.8"
        ],
        "env": {
          "HF_HUB_OFFLINE": "1",
          "HF_HUB_DISABLE_TELEMETRY": "1",
          "VLLM_NO_USAGE_STATS": "1",
          "DO_NOT_TRACK": "1",
          "VLLM_API_KEY": ""
        },
        "entrypoint": ["/bin/bash", "-lc"]
      }
    }
  ]
}
