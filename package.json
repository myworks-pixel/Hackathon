{
  "name": "hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "worker": "node scripts/worker.mjs",
    "test": "node scripts/test.mjs",
    "demo:data": "node scripts/demo-data.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "check:ai": "node scripts/check-ai.mjs",
    "setup:ai": "npm install && npm run check:ai && npm run check && npm run build",
    "ui:add": "shadcn add",
    "ui:add:all": "shadcn add --all --yes",
    "setup": "npm install && npm run ui:add:all && npm run format && npm run check && npm run build",
    "check:partners": "node --env-file-if-exists=.env.local scripts/check-partners.mjs",
    "setup:codeaf": "node --env-file-if-exists=.env.local scripts/setup-codeaf-snapshot.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@daytona/sdk": "^0.231.0",
    "jiti": "^2.7.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@langchain/core": "latest",
    "@langchain/langgraph": "latest",
    "@langchain/openai": "latest",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "latest",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "langchain": "latest",
    "lucide-react": "latest",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "latest",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.22.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "latest",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "latest",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
